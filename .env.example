# Copy to .env.local (dev) or set in your server environment.

# Public URL of the app, used in invite links and notification emails.
APP_URL=http://localhost:3000

# First access manager, created on first start if no account with this email exists.
# Sign in with these, then change the password under Account.
ADMIN_EMAIL=alok@fairdeal.market
ADMIN_NAME=Alok
ADMIN_INITIAL_PASSWORD=change-me-on-first-login-1

# Where the SQLite database and uploaded photos/videos are stored.
# Must be a persistent disk in production — back this folder up.
DATA_DIR=./data

# Strongly recommended: an S3-compatible bucket that keeps a copy of every
# uploaded file and every database backup off this server. Enable
# versioning on the bucket. Works with AWS S3, Cloudflare R2, Backblaze B2...
# S3_BUCKET=fairdeal-expansion-portal
# S3_REGION=ap-south-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com   # only for non-AWS providers
# S3_FORCE_PATH_STYLE=false
# S3_PREFIX=expansion-portal

# Database backups (defaults shown). Point BACKUP_DIR at a second disk if you have one.
# BACKUP_DIR=./data/backups
# BACKUP_INTERVAL_HOURS=6
# BACKUP_KEEP=60

# Optional: send invites, notifications and LOIs by email.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=expansion-portal@fairdeal.market
# SMTP_PASS=app-password
# SMTP_FROM="Expansion Portal <expansion-portal@fairdeal.market>"

# Optional limits (defaults shown).
# MAX_IMAGE_MB=25
# MAX_VIDEO_MB=500
# MAX_DOCUMENT_MB=25
# MAX_FILES_PER_PROPERTY=300
# SESSION_DAYS=7
# INVITE_DAYS=7
