# Copy to .env.local (development) or set in your host's environment.

# Public URL of the app (invite links, emails, bucket CORS).
APP_URL=http://localhost:3000

# First access manager, created on first start if that email has no account.
ADMIN_EMAIL=alok@fairdeal.market
ADMIN_NAME=Alok
ADMIN_INITIAL_PASSWORD=change-me-on-first-login-1

# Managed PostgreSQL (Neon, Supabase, RDS…). Without it an embedded Postgres
# runs under DATA_DIR — fine for development, not for production.
# DATABASE_URL=postgres://user:password@host/db?sslmode=require

# File storage: an S3-compatible bucket (Cloudflare R2, AWS S3…). Files of any
# size upload straight from the browser. Without it files go to DATA_DIR/uploads.
# S3_BUCKET=fairdeal-expansion
# S3_REGION=auto
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PREFIX=expansion-portal
# S3_FORCE_PATH_STYLE=false

# Local data folder (embedded database, local uploads, local backups).
DATA_DIR=./data

# Backups (defaults shown). CRON_SECRET protects the Vercel Cron backup job.
# BACKUP_INTERVAL_HOURS=6
# BACKUP_DIR=./data/backups
# CRON_SECRET=

# Optional email for invites, notifications and LOIs.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=expansion@fairdeal.market
# SMTP_PASS=app-password
# SMTP_FROM="fairdeal.market Expansion <expansion@fairdeal.market>"

# Demo mode: sample accounts and properties (automatic on Vercel without a database).
# DEMO_MODE=true
